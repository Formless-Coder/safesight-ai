# SafeSight AI Backend Environment Configuration

# Application
ENVIRONMENT=development
PROJECT_NAME="SafeSight AI Backend"
API_V1_STR=/api/v1

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=safesight_user
POSTGRES_PASSWORD=safesight_password_placeholder
POSTGRES_DB=safesight_db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000"
